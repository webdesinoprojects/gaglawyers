# Production Environment Variables
# Copy this to .env in production and update with real values

PORT=5000
NODE_ENV=production

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=Cluster0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# Site URL - IMPORTANT: Use non-www version for consistency
# This MUST match your canonical domain in Google Search Console
SITE_URL=https://gaglawyers.com

# Admin Credentials
ADMIN_EMAIL=admin@gaglawyers.com
ADMIN_PASSWORD=change-this-secure-password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (for contact forms)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=contact@gaglawyers.com

# reCAPTCHA Secret Key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
